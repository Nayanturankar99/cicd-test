[Unit]
Description=Start Panel Java Service

[Service]
WorkingDirectory=/opt/jars
ExecStart=java -javaagent:elastic-apm-agent.jar -Delastic.apm.service_name=optimus-p -Delastic.apm.server_url=https://elastic-apm.joinventures.com:8200 -Delastic.apm.environment={{ec2_tag_environment}} -Delastic.apm.application_packages=com.igp -jar distribution.jar
User=root
Type=simple

[Install]
WantedBy=multi-user.target