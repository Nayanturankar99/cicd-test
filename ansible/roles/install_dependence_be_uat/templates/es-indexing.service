[Unit]
Description=Start Panel Java Service


[Service]
WorkingDirectory=/opt/jars
ExecStart=java -DserverProperty=/opt/properties/application.properties -jar /opt/jars/distribution.jar -Xms 1G -Xmx 3G
#ExecStart=java -DserverProperty=/opt/properties/start.ini -javaagent:/opt/jars/elastic-apm-agent.jar -Delastic.apm.service_name=panelapi-p -Delastic.apm.server_url=https://elastic-apm.joinventures.com:8200 -Delastic.apm.environment={{ec2_tag_environment}} -Delastic.apm.application_packages=org.igp -jar distribution.jar
User=root
Type=simple
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target